# Local Qdrant vector database (start with: docker compose up -d)
QDRANT_URL=http://127.0.0.1:6333
# Leave blank for the local Docker setup. Set this for an authenticated remote Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=quiznest_documents

# Choose one provider mode. Offline is local Ollama; online uses OpenAI APIs.
RAG_MODE=offline

# Offline/local models. Download these once with `ollama pull` before use.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_CHAT_MODEL=qwen3:0.6b
# Optional override if you change the embedding model. Defaults: offline 384, online 1536.
EMBEDDING_DIMENSIONS=

# Required only when RAG_MODE=online. Keep this server-side.
OPENAI_API_KEY=
# Optional. Used only when RAG_MODE=online.
OPENAI_CHAT_MODEL=gpt-5.4-mini
